# Repeater configuration for docker compose. bootstrap.sh copies this file to deploy/.env
# (chmod 600) on the first run and generates every secret marked "generated".
# Never commit deploy/.env. Keep a copy of it in a password manager: losing
# REPEATER_TOKEN_ENCRYPTION_KEYS means every connected account must be reconnected.
#
# Format: KEY=value, no spaces around "=". Values with $, spaces, # or quotes must be
# wrapped in single quotes. Commented lines show the built-in default.

# =========================================================================== compose / host
# Public hostname of the dashboard; Caddy requests its certificate. DNS A record -> this VPS.
REPEATER_DOMAIN=rotator.magic-lap.com
# "caddy" runs Repeater's own HTTPS proxy on ports 80/443. Leave empty when another reverse
# proxy (nginx, Traefik, Coolify...) already owns 80/443 and forwards to the web port below.
COMPOSE_PROFILES=
# Host address and port of the dashboard container (behind the reverse proxy).
# 127.0.0.1 for a proxy installed on the host; the docker0 address (e.g. 172.17.0.1) when
# the proxy itself runs in a container. Never 0.0.0.0: Docker bypasses ufw.
REPEATER_WEB_BIND=127.0.0.1
REPEATER_WEB_PORT=8090
# Host directory with the video library (owned by uid 10001, the app user in the image).
REPEATER_MEDIA_DIR=/srv/repeater/media
# Postgres password (generated: 64 hex characters; must stay URL-safe).
POSTGRES_PASSWORD=
# Resource caps for the worker (ffmpeg runs there). Repeater as a whole stays near
# 2 vCPU / 6 GB so other Magic Lap projects on this VPS keep their share (PLAN.md 6.1).
REPEATER_WORKER_CPUS=1.0
REPEATER_WORKER_MEMORY=3G

# =========================================================================== backups (backup.sh)
# Days of daily database dumps kept in /srv/repeater/backups.
BACKUP_RETENTION_DAYS=14
# Optional off-site copy with rclone (configured on the host with `rclone config`),
# e.g. r2:magiclab-repeater. Empty disables it.
RCLONE_REMOTE=
# Media sync to RCLONE_REMOTE: weekly (Sundays), daily or off.
RCLONE_MEDIA_SYNC=weekly

# =========================================================================== application
# production enables secure cookies and HSTS, and `repeater.cli check` rejects weak secrets.
REPEATER_ENV=production
# Public HTTPS origin; OAuth redirect URIs and signed media links are built from it.
REPEATER_BASE_URL=https://rotator.magic-lap.com
# Set by docker-compose.yml from POSTGRES_PASSWORD; set here only for an external database.
# REPEATER_DATABASE_URL=postgresql+psycopg://repeater:<password>@db:5432/repeater

# Sessions, CSRF and signed media URLs (generated: 64 random URL-safe characters).
REPEATER_SECRET_KEY=
# OAuth token encryption key ring, "kid:base64url(32 bytes)" (generated). To rotate, put a
# new key FIRST and keep the old ones after it, comma-separated: k2:NEW,k1:OLD
REPEATER_TOKEN_ENCRYPTION_KEYS=

# Fixed to /srv/repeater/media inside the containers by docker-compose.yml.
# REPEATER_MEDIA_ROOT=/srv/repeater/media
# Lifetime of signed video links the platforms download from (seconds).
REPEATER_MEDIA_URL_TTL_SECONDS=21600
# Largest dashboard upload (MB). Caddy allows 600 MB; raise both together.
REPEATER_MAX_UPLOAD_MB=500

REPEATER_DEFAULT_TIMEZONE=Africa/Cairo
REPEATER_DEFAULT_LOCALE=ar

# =========================================================================== platform apps
# Empty = platform not configured. Redirect URIs to register with each platform:
#   https://<REPEATER_DOMAIN>/oauth/tiktok/callback   (docs/ar/01-tiktok.md)
#   https://<REPEATER_DOMAIN>/oauth/google/callback   (docs/ar/02-google.md)
#   https://<REPEATER_DOMAIN>/oauth/meta/callback     (docs/ar/03-meta.md)
REPEATER_TIKTOK_CLIENT_KEY=
REPEATER_TIKTOK_CLIENT_SECRET=
REPEATER_GOOGLE_CLIENT_ID=
REPEATER_GOOGLE_CLIENT_SECRET=
REPEATER_META_APP_ID=
REPEATER_META_APP_SECRET=
REPEATER_META_GRAPH_VERSION=v26.0

# =========================================================================== notifications
# Telegram alerts (docs/ar/04-telegram.md). Both empty = no alerts.
REPEATER_TELEGRAM_BOT_TOKEN=
REPEATER_TELEGRAM_CHAT_ID=

# =========================================================================== unofficial import (yt-dlp)
# Optional proxy for yt-dlp downloads, e.g. http://user:pass@host:port (quote it if it has $).
REPEATER_YTDLP_PROXY=
# Directory with per-source cookie files named source-<id>.txt (inside the media volume).
# REPEATER_YTDLP_COOKIES_DIR=/srv/repeater/media/.cookies

# =========================================================================== worker
# REPEATER_WORKER_POLL_SECONDS=2.0
# REPEATER_WORKER_THREADS=2
# REPEATER_JOB_LOCK_TIMEOUT_MINUTES=30
# The worker healthcheck in docker-compose.yml reads this path too.
# REPEATER_WORKER_HEARTBEAT_PATH=/tmp/repeater-worker.heartbeat
# REPEATER_LOG_LEVEL=INFO

# =========================================================================== retention
# REPEATER_ORIGINAL_RETENTION_DAYS=30
# YouTube API policy: refresh or delete stored API data within 30 days.
# REPEATER_PLATFORM_DATA_RETENTION_DAYS=30

# =========================================================================== advanced
# REPEATER_FFMPEG_BIN=ffmpeg
# REPEATER_FFPROBE_BIN=ffprobe
# REPEATER_SESSION_COOKIE_NAME=repeater_session
# REPEATER_SESSION_MAX_AGE_SECONDS=1209600
# JSON list. Caddy already routes only REPEATER_DOMAIN; if you restrict hosts here, keep
# 127.0.0.1 for the container health check: ["rotator.magic-lap.com","127.0.0.1"]
# REPEATER_TRUSTED_HOSTS=["*"]
